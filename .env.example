# Neon PostgreSQL (server only). Use the pooled connection string.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Neon Managed Auth base URL (server only).
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
NEON_AUTH_TRUSTED_ORIGIN=https://<your-app>.vercel.app

# Public origin of the app (CORS + password reset redirects).
APP_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# API port for local `pnpm dev:server`
PORT=3005
